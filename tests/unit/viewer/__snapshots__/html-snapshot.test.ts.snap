ne class="nm-limit" x1="44" x2="948" y1="76" y2="76" stroke="var(--limit)" stroke-width="1.5" stroke-dasharray="5 4"/><line class="nm-limit-key" x1="44" x2="62" y1="10" y2="10" stroke="var(--limit)" stroke-width="1.5" stroke-dasharray="5 4"/><text x="68" y="14" fill="var(--ink-2)" class="nm-label">100%, your plan's limit</text><line class="nm-reset" x1="948" x2="948" y1="56" y2="276" stroke="var(--ink-2)" stroke-width="1"/><text x="948" y="34" fill="var(--ink-2)" class="nm-label" text-anchor="end">Resets 2026-09-03 13:00</text><path class="nm-data nm-hit" data-events="8" d="M646.53 276V56M646.53 56h8l-8 5z" fill="var(--limit)" stroke="var(--limit)" stroke-width="1.5"><title>Limit hit at 2026-09-03 12:00</title></path><path class="nm-data nm-line" data-events="11 12 13" d="M44 236L45.26 156L636.48 70" fill="none" stroke="var(--water)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><title>Observed usage in the 5-hour window resetting 2026-09-03 13:00, 3 readings</title></path><circle class="nm-data nm-point" data-events="11" cx="44" cy="236" r="4" fill="var(--water)" stroke="var(--surface)" stroke-width="2"><title>Observed usage 20% at 2026-09-03 10:00</title></circle><circle class="nm-data nm-point" data-events="12" cx="45.26" cy="156" r="4" fill="var(--water)" stroke="var(--surface)" stroke-width="2"><title>Observed usage 60% at 2026-09-03 10:00</title></circle><circle class="nm-data nm-point" data-events="13" cx="636.48" cy="70" r="4" fill="var(--water)" stroke="var(--surface)" stroke-width="2"><title>Observed usage 103% at 2026-09-03 11:58</title></circle><text x="44" y="292" fill="var(--muted)">2026-09-03 10:00</text><text x="44" y="330" fill="var(--muted)" class="nm-span">Readings 2026-09-03 10:00 to 11:58 (UTC)</text></svg></div>
